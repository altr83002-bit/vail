DISCORD_TOKEN=
CLIENT_ID=
# optional: only these user IDs can use the bot (comma-separated). empty = everyone
OWNER_IDS=
# optional: lock to one channel ID. empty = all channels
LOCKED_CHANNEL_ID=
# upstream (same as Nova)
LEAKD_BASE=https://leakd.up.railway.app
PROXY_ENABLED=1
# max attachment size in MB
MAX_BODY_MB=8
# guild for instant slash register (optional, speeds first deploy)
GUILD_ID=
# timeouts (ms)
UPSTREAM_TIMEOUT_MS=25000
LOCAL_TIMEOUT_MS=15000
COMMAND_TIMEOUT_MS=45000
